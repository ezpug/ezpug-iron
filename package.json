{
  "name": "ezpug-iron",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.19 <23"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check --error-on-warnings . && ./scripts/lint/guard-selftest.sh && node scripts/check-pins.mjs && node scripts/protocol-codegen.mjs --check",
    "lint:fix": "biome check --write .",
    "verify": "turbo run build typecheck lint test && turbo boundaries",
    "verify:extended": "./scripts/verify-extended.sh",
    "boundaries": "turbo boundaries",
    "release": "node scripts/release.mjs",
    "dev": "turbo run dev --filter=@ezpug/orchestrator",
    "plugins:publish": "./plugins/publish.sh",
    "image:build": "docker build -f docker/orchestrator/Dockerfile --build-arg EZPUG_GIT_SHA=$(git rev-parse --short HEAD) -t ghcr.io/ezpug/ezpug-iron/orchestrator:dev .",
    "cs2:build": "./scripts/cs2-env.sh build",
    "cs2:install": "./scripts/cs2-env.sh install",
    "cs2:up": "./scripts/cs2-env.sh up",
    "cs2:down": "./scripts/cs2-env.sh down",
    "cs2:status": "./scripts/cs2-env.sh status",
    "cs2:logs": "./scripts/cs2-env.sh logs",
    "cs2:console": "./scripts/cs2-env.sh console",
    "node": "pnpm --filter @ezpug/node start",
    "node:build": "docker build -f docker/node/Dockerfile --build-arg EZPUG_GIT_SHA=$(git rev-parse --short HEAD) -t ghcr.io/ezpug/ezpug-iron/node:dev .",
    "dev:up": "./scripts/dev-env.sh up",
    "dev:down": "./scripts/dev-env.sh down",
    "dev:reset": "./scripts/dev-env.sh reset",
    "dev:status": "./scripts/dev-env.sh status",
    "dev:logs": "./scripts/dev-env.sh logs",
    "dev:node": "./scripts/dev-node.sh",
    "iron:match": "node scripts/iron-match.mjs",
    "dathost:image": "node scripts/dathost-image.mjs",
    "dathost:smoke": "node scripts/dathost-smoke.mjs",
    "db:generate": "pnpm --filter @ezpug/orchestrator db:generate",
    "db:migrate": "pnpm --filter @ezpug/orchestrator db:migrate"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.10",
    "publint": "^0.3.24",
    "turbo": "^2.10.11"
  }
}
