{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tags": ["plugins"],
  "tasks": {
    "typecheck": {
      // `dotnet build` is its own incremental cache; letting Turbo cache it
      // would mean a cache hit with no bin/ for `--no-build` to test.
      "cache": false
    },
    "test": {
      // `dotnet test --no-build` runs the assemblies `typecheck` built —
      // two concurrent builds of one solution race on obj/, so it waits.
      "cache": false,
      "dependsOn": ["typecheck"]
    }
  }
}
