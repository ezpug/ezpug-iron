{
  "name": "@ezpug/match-api",
  "version": "0.0.0",
  "description": "The Match API of EZPug Iron: the gameserver event vocabulary, the resources and routes a client speaks to the orchestrator, the webhook envelope and verifier, the stream frames, the gamemode manifest, a typed client, conformance fixtures and an in-process fake orchestrator.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ezpug/ezpug-iron.git",
    "directory": "packages/match-api"
  },
  "homepage": "https://github.com/ezpug/ezpug-iron/tree/main/packages/match-api#readme",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client/index.ts",
    "./webhooks": "./src/webhooks/index.ts",
    "./fixtures": "./src/fixtures/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./client": {
        "types": "./dist/client/index.d.ts",
        "import": "./dist/client/index.js"
      },
      "./webhooks": {
        "types": "./dist/webhooks/index.d.ts",
        "import": "./dist/webhooks/index.js"
      },
      "./fixtures": {
        "types": "./dist/fixtures/index.d.ts",
        "import": "./dist/fixtures/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "peerDependencies": {
    "zod": "^4.4.0"
  },
  "devDependencies": {
    "@ezpug/core": "workspace:*",
    "@ezpug/gamemodes": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
