{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": [".env"],
  "globalEnv": ["NODE_ENV", "EZPUG_*"],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["transit"]
    },
    "test": {
      "dependsOn": ["transit"]
    },
    "test:extended": {
      // The extended tier (CLAUDE.md "Verify"): the conformance suite over
      // HTTP, the determinism test, later the live lanes. Never cached — it
      // is the tier that exists to be re-run.
      "cache": false,
      "dependsOn": ["transit"]
    },
    "//#lint": {
      // One Biome process over the whole repo plus the lint guards' self-test:
      // faster than per-package tasks, and it covers the files no package owns
      // (scripts/, root configs). Turbo never caches root tasks, so lint always
      // really runs — cheap enough not to care.
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  },
  "boundaries": {
    // Every workspace package carries exactly one of these tags in its own
    // turbo.json. `turbo boundaries` (the last step of `pnpm verify`) refuses
    // a dependency edge the tag denies.
    "tags": {
      "published": {
        // `@ezpug/match-api` and anything else that leaves this repo: it may
        // lean on `core` (bundled into its dist) and on nothing else internal,
        // so a consumer never drags an app or a provider along.
        "dependencies": { "deny": ["app", "internal", "plugins"] }
      },
      "core": {
        // The determinism primitives depend on nothing.
        "dependencies": { "deny": ["app", "published", "internal", "plugins", "engine", "data"] }
      },
      "data": {
        // Authored data every side reads (the gamemode manifests) and, beside
        // an `sdk` mode's manifest, its widget source: no code of its own that
        // anything imports, and the one edge it has is the `kit` that builds
        // the widget (a devDependency, PRD-02 T25). `published` bundles the
        // manifests, the apps and plugins read them.
        "dependencies": {
          "deny": ["app", "published", "core", "internal", "plugins", "data", "engine"]
        }
      },
      "kit": {
        // `gamemode-kit` (PRD-02 T25): the widget toolchain. Its runtime leans
        // on nothing internal (a widget bundle carries Vue and the kit, never a
        // schema library), its dev harness runs the published fake, and only
        // `data` depends on it — to build what a manifest names.
        "dependencies": { "deny": ["app", "internal", "plugins", "engine", "data"] },
        "dependents": { "deny": ["app", "published", "core", "internal", "plugins", "engine"] }
      },
      "internal": {
        // Internal packages (the protocol): shared by the apps, never reaching
        // into one, never leaving the repo.
        "dependencies": { "deny": ["app", "plugins"] }
      },
      "engine": {
        // The simulator engine (`packages/sim`, PRD-01 T5): it speaks the
        // published vocabulary as a *peer* (not a graph edge, so no cycle) and
        // leans on `core`; the orchestrator runs it and the published fake
        // bundles it as a devDependency. Never an app, never a plugin.
        "dependencies": { "deny": ["app", "internal", "plugins", "data"] }
      },
      "app": {
        // apps/orchestrator, apps/node, apps/cli: an app never imports an app,
        // and nothing imports an app.
        "dependencies": { "deny": ["app"] },
        "dependents": { "deny": ["app", "published", "core", "internal", "plugins", "engine"] }
      },
      "plugins": {
        // The dotnet wrapper is a leaf both ways: it runs `dotnet`, it imports
        // nothing and nothing imports it.
        "dependencies": { "deny": ["app", "published", "core", "internal", "engine"] },
        "dependents": { "deny": ["app", "published", "core", "internal", "plugins", "engine"] }
      }
    }
  }
}
