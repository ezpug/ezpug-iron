{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // The CLI runs on Node's own type stripping (`node hud/src/cli.ts`), so
    // imports name their `.ts` files and only erasable syntax is allowed.
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "types": ["node"]
  },
  "include": ["src", "test"]
}
