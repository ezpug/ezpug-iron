<!--
  The hello panel (PRD-07 T1): the smallest layout that proves the pipeline end to end.
  A label bound to a dialog variable, a picture as a background, a class that slides it in.

  Rules every layout in hud/layout/ keeps (docs/hud.md, the Findings of ralph/PRD-07-hud.md):
  - the root panel carries no id; the server addresses the panel inside it;
  - only Panel, Label, Image and Button; pictures are backgrounds, never <Image>;
  - no inline style; nothing takes the mouse (hittest="false" everywhere).
-->
<root>
	<styles>
		<include src="s2r://panorama/styles/custom_game/ezpug_hello.vcss_c" />
	</styles>

	<Panel class="ezpug-screen" hittest="false">
		<Panel id="hello" class="ezpug-hello" hittest="false">
			<Panel class="ezpug-hello-picture" hittest="false" />
			<Label id="hello_line" class="ezpug-hello-line" text="{s:line}" />
		</Panel>
	</Panel>
</root>
