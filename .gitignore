# Dependencies & build output
node_modules/
dist/
.turbo/
*.log
test-results/
bin/
obj/
# `bin/` above is .NET's build output. An app's one-line `bin/` wrapper is
# source — the name its package.json's `bin` field points at — and a clone
# without it is a clone whose manifest names a file that is not there.
!apps/*/bin/
# The vendored community plugins build where their own csproj says
plugins/vendor/cs2-retakes/build-output/
TestResults/
*.user

# Env & secrets
.env
.env.*
!.env.example
!.env.production.example
*.local.txt

# What `pnpm verify:extended` leaves behind: the tier's JSON test reports
# (scripts/verify-report.mjs reads them), a run's evidence and never source
.verify/

# The CS2 install is a docker volume, never a checkout; anything a script
# downloads lands here
.cache/
downloads/

# A node's identity on this box (`ezpug-node enrol`, PRD-02 T11): the node
# token lives here and nowhere else
.ezpug-node/

# Upstream reference clones — external repos, restorable via references/README.md
references/CounterStrikeSharp/
references/MatchZy/
references/cs2-WeaponPaints/
references/cs2-retakes/
references/legacy/

# OS/editor noise
.DS_Store
