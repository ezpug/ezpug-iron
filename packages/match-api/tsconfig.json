{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // The contract is isomorphic: the platform's browser bundles import the
    // schemas, its API imports the client — so the DOM lib for `fetch` and
    // `Response`, never @types/node.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    // The platform's recorded fixtures are JSON the tests parse against the
    // vocabulary (`src/fixtures/platform/`).
    "resolveJsonModule": true
  },
  "include": ["src", "tsdown.config.ts"]
}
