# EZPug Iron in production — the template for `.env.production` (PRD-02 T35).
#
#   cp .env.production.example .env.production   # then fill in every CHANGE_ME
#   ./scripts/deploy.sh                          # preflight refuses the rest
#
# `.env.production` is gitignored and this file is not, so **nothing real ever
# goes below this line**. It is read twice by `compose.prod.yaml`: once to
# interpolate `${…}` (the Postgres credentials, the published port, the image),
# and once as the orchestrator container's own environment. Which is why the
# hostnames here are *compose service names* — `postgres`, `redis` — and not
# addresses on this box: that is where these processes actually run.
#
# Every variable the orchestrator reads is documented in `.env.example`; this
# file names only the ones production decides differently, plus the handful
# that exist for the deploy itself. Anything not here keeps its default.

# ── The deployment ──────────────────────────────────────────────────────────
# `production` is what turns off every dev door: the bootstrap API key is
# refused, the trace recorder is refused, chaos is never read, fake GSLTs are
# refused. `deploy.sh preflight` will not deploy anything else.
NODE_ENV=production

# The public origin. Everything is minted against it: a server's link URL, a
# player token's audience, a webhook's source, a widget's CSP. It is the
# hostname `docker/traefik/ezpug-iron.yml` routes and the one every CS2 server
# and every `ezpug-node` in the world dials — change it here and there
# together, or not at all.
EZPUG_IRON_PUBLIC_URL=https://gs.ezpug.com

# What Traefik reaches this stack on, published to the docker bridge gateway
# (172.17.0.1) and to nothing else. It is written down twice — here and in
# `docker/traefik/ezpug-iron.yml` — and preflight refuses a disagreement.
EZPUG_IRON_HOST_PORT=3431

# **The name on every row this process writes** and the Dathost `user_data`
# tag it claims clones by. It must differ from every other world sharing this
# Dathost account or this database — a dev orchestrator carrying the same name
# reaps production's servers and ends production's matches. The default is
# `ezpug`, which is what the dev world uses, so production says so out loud.
EZPUG_IRON_DEPLOYMENT=production

# The providers this deployment registers. `dathost` needs the trio below —
# all three or none, or the boot fails naming what is missing — and `nodes`
# needs an enrolled `ezpug-node` at a venue (docs/nodes.md). Take `sim` out the
# day both are real: a simulated server is a development answer, and a match
# nobody asked to simulate must land on iron.
EZPUG_IRON_PROVIDERS=dathost,nodes

# The CS2 image an `ezpug-node` is told to start servers from. Pin a published
# tag by digest in production; `:dev` is what a box built for itself.
#EZPUG_IRON_NODE_SERVER_IMAGE=ghcr.io/ezpug/ezpug-iron/cs2:1.0.0

# ── The image ───────────────────────────────────────────────────────────────
# Left unset, `compose.prod.yaml` builds this checkout into
# `ezpug-iron/orchestrator:latest` and keeps the one it replaced as
# `:previous`, which is what `./scripts/deploy.sh rollback` puts back. Set to a
# published tag (`ghcr.io/ezpug/ezpug-iron/orchestrator:1.2.3`, docs/pins.md)
# to deploy *that* instead: `deploy.sh build` then pulls rather than builds, so
# a pinned release can never be quietly overwritten by a local build, and
# rolling back is bumping this line.
#EZPUG_IRON_IMAGE=ghcr.io/ezpug/ezpug-iron/orchestrator:1.2.3

# ── Postgres ────────────────────────────────────────────────────────────────
# Its own instance on a named volume, published to nobody. The database holds
# the webhook secrets and the GSLT login tokens **in clear** (docs/operations.md,
# "What this database holds in clear, and why"), so this password is a real
# secret and a dump of it is a credential.
#   openssl rand -base64 24 | tr -d '=+/'
EZPUG_IRON_POSTGRES_USER=ezpug_iron
EZPUG_IRON_POSTGRES_PASSWORD=CHANGE_ME
EZPUG_IRON_POSTGRES_DB=ezpug_iron
# The same three, as the URL the process dials. `postgres` is the compose
# service; there is no host port to point at.
EZPUG_IRON_DATABASE_URL=postgres://ezpug_iron:CHANGE_ME@postgres:5432/ezpug_iron

# ── Redis ───────────────────────────────────────────────────────────────────
EZPUG_IRON_REDIS_URL=redis://redis:6379

# ── Backups ─────────────────────────────────────────────────────────────────
# Where `./scripts/deploy.sh backup` writes, and where it dumps to before every
# migration. On the host, outside the checkout and outside the compose volumes,
# because `compose down -v` is the one command that destroys this ledger.
# Absolute paths only; preflight refuses one inside the repo.
#EZPUG_IRON_BACKUP_DIR=/var/backups/ezpug-iron
#EZPUG_IRON_BACKUP_KEEP=14

# ── The operator's key ──────────────────────────────────────────────────────
# What the deploy's smoke reads `GET /v1/capacity` with, and what `ezpug-iron`
# on this box authenticates as. Mint the deployment's *first* key once —
#
#   ./scripts/deploy.sh key --name operator --scopes admin,matches,fleet
#
# — and paste the secret it prints here; every key after that is
# `ezpug-iron keys create` over the Match API. Environment or this file only:
# never a flag, never a log line, never a commit.
EZPUG_IRON_API_KEY=CHANGE_ME
# Where `ezpug-iron` on this box points when `--url` does not say.
EZPUG_IRON_CLI_URL=https://gs.ezpug.com

# ── Dathost (decision 7) ────────────────────────────────────────────────────
# The rented capacity. All three or none: with a partial trio the boot fails
# naming what is missing, and with none of them take `dathost` out of
# EZPUG_IRON_PROVIDERS above. The template server is what every match is cloned
# from — `pnpm iron dathost image --build` prints its id (docs/operations.md).
EZPUG_IRON_DATHOST_EMAIL=CHANGE_ME
EZPUG_IRON_DATHOST_PASSWORD=CHANGE_ME
EZPUG_IRON_DATHOST_TEMPLATE_SERVER_ID=CHANGE_ME
EZPUG_IRON_DATHOST_LOCATION=dusseldorf

# ── The GSLT pool (decision 20) ─────────────────────────────────────────────
# A rented CS2 server without a Steam Game Server Login Token accepts LAN
# connections only, so every Dathost allocation needs one. The pool mints from
# Valve's `IGameServersService` with this key; a deployment with no `dathost`
# provider needs neither line.
STEAM_WEB_API_KEY=CHANGE_ME
#EZPUG_IRON_GSLT_POOL_MAX=16

# ── Not here, ever ──────────────────────────────────────────────────────────
# EZPUG_IRON_BOOTSTRAP_API_KEY — a dev door; the process refuses it under
#   NODE_ENV=production and preflight refuses the file that names it.
# EZPUG_IRON_TRACE_FILE, EZPUG_IRON_CHAOS, EZPUG_IRON_STEAM_FAKE_TOKENS —
#   development instruments, all refused in production for the same reason.
# EZPUG_IRON_TEST_DATABASE_URL — there is no test database on this box.
