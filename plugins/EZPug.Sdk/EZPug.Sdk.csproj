<Project Sdk="Microsoft.NET.Sdk">
  <!--
    EZPug.Sdk: what a gamemode is written over (CLAUDE.md "The plugin is thin, the
    SDK is the product"). The seams — IGameWorld, IPlatformLink, IClock — keep
    CounterStrikeSharp out of a gamemode entirely; the link client, the event
    model, per-player state, player commands with their cooldowns and charges,
    and the bilingual Localizer live here once. The CounterStrikeSharp-backed
    implementations of the seams ship with the core plugin (PRD-02 T8); this
    assembly references the API only so those adapters can be typed against it.
    EZPug.Sdk.Testing holds the fakes and the harness a gamemode test runs on.
  -->
  <PropertyGroup>
    <RootNamespace>EZPug.Sdk</RootNamespace>
    <AssemblyName>EZPug.Sdk</AssemblyName>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CounterStrikeSharp.API" Version="$(CounterStrikeSharpApiVersion)" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The SDK's own lines (I18n/Lines.*.resx) are embedded as the raw resx XML and
      parsed by ResxCatalog at runtime — no resgen, no satellite assembly. A plugin
      is loaded by CounterStrikeSharp into its own load context from one folder,
      and a satellite assembly that has to be found in a culture subfolder beside
      it is one more thing that can silently go missing; one assembly with the
      German and English text inside it cannot. A gamemode embeds its own the
      same way (docs/sdk.md).
    -->
    <EmbeddedResource Remove="I18n\*.resx" />
    <EmbeddedResource Include="I18n\*.resx" Type="Non-Resx" WithCulture="false" LogicalName="EZPug.Sdk.I18n.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The addon's build stamp (PRD-09 T8, Hud/HudStamp.cs): hud/dist/manifest.json, as
      `pnpm hud:build` wrote it, embedded whole, so `ezpug_status` can say which revision
      of the addon this build was made beside. The CS2 image's Dockerfile copies the
      file to the same place beside the sources; a build without it is an error, never a
      plugin that says "unstamped" in production.
    -->
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)../../hud/dist/manifest.json" LogicalName="EZPug.Sdk.hud.manifest.json" Condition="Exists('$(MSBuildThisFileDirectory)../../hud/dist/manifest.json')" />
  </ItemGroup>

  <Target Name="RequireHudManifest" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)../../hud/dist/manifest.json')" Text="hud/dist/manifest.json is missing beside the plugin sources: the SDK embeds the addon's build stamp from it (run `pnpm hud:build`, or copy the file in a container build)" />
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="EZPug.Sdk.Tests" />
    <InternalsVisibleTo Include="EZPug.Sdk.Testing" />
  </ItemGroup>
</Project>
